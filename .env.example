APP_NAME=Becoming
PHOTO_REQUESTS_PER_HOUR=20
PHOTO_REQUESTS_PER_DAY=100
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://becoming.test

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=becoming
DB_USERNAME=root
DB_PASSWORD=

# Local, free photo-verification AI (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
